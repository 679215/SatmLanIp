<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>SatmLanIp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- LanSession fields are written by game-side transport, not this compile. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- Pure protocol/helpers — no game interop; CI runs this without libs/. -->
  <ItemGroup>
    <Compile Include="..\..\src\SatmLanIp\Lan\LanProtocol.cs" Link="src\LanProtocol.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanRoom.cs" Link="src\LanRoom.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanPose.cs" Link="src\LanPose.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanConfig.cs" Link="src\LanConfig.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanLocalIp.cs" Link="src\LanLocalIp.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanHostParse.cs" Link="src\LanHostParse.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanBuild.cs" Link="src\LanBuild.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanFusionStart.cs" Link="src\LanFusionStart.cs" />
    <Compile Include="..\..\src\SatmLanIp\Lan\LanSession.cs" Link="src\LanSession.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
